{
  "manifest_version": 3,
  "name": "Quick Article Copy",
  "version": "1.0.0",
  "description": "Mozilla Readabilityを利用して、ネット記事の本文をMarkdown形式でサクッとコピペする拡張機能",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "copy-markdown": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "記事本文をMarkdownで即座にコピー"
    }
  }
}
